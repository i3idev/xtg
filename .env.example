# ---------------------------------------------------------------------------
# eXtractorT configuration template.
# Copy to `.env` and fill in real values:   cp .env.example .env
# Every variable can also be passed as a real environment variable (XTG_*).
# ---------------------------------------------------------------------------

# --- Telegram API credentials (https://my.telegram.org) --------------------
# Both values are REQUIRED before `xtg auth login` can work.
XTG_API_ID=
XTG_API_HASH=

# --- Storage ---------------------------------------------------------------
# Absolute path override. Defaults to the project root (the directory that
# contains pyproject.toml).
# XTG_HOME=/home/user/telegram-osint

# Session file name, without extension. Stored in <home>/data/sessions/.
XTG_SESSION_NAME=xtg

# SQLite database file. Relative paths resolve against XTG_HOME.
XTG_DATABASE_PATH=data/database.db

# --- Proxy subsystem -------------------------------------------------------
XTG_PROXY_ENABLED=true
# Proxy list file. Defaults to the bundled xtg/proxy/list_proxy.json.
# XTG_PROXY_FILE=data/list_proxy.json

# --- Logging ---------------------------------------------------------------
XTG_LOG_LEVEL=INFO
XTG_LOG_TO_FILE=true

# --- Collection tuning (used by `xtg collect`, Phase 2) ---------------------
# Delay between API requests, in seconds. Protects against flood limits.
XTG_REQUEST_DELAY=0.5
XTG_MAX_RETRIES=3
XTG_CONNECT_TIMEOUT=10.0